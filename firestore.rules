rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cualquiera puede ver el catálogo y las fotos; solo tu correo puede modificarlos.
    match /catalogo/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "TU_CORREO@ejemplo.com";
    }
    match /fotos/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "TU_CORREO@ejemplo.com";
    }
  }
}
